# Copy this file to .env and fill in the values you need.
# Only the services you actually use need credentials; the UI tells you
# what is missing for each action.

# --- Web app -----------------------------------------------------------------
# Shared password for the web UI. Strongly recommended when hosting online.
# Leave unset for a local, single-user setup (the UI shows a warning).
APP_PASSWORD=change-me

# Optional: keep login sessions valid across restarts (any long random string).
# SOS_SECRET_KEY=

# Optional: where persistent data lives (default: ./data, /data in Docker).
# SOS_DATA_DIR=./data

# Optional: public address of the app, used to build the Google OAuth redirect.
# SOS_PUBLIC_URL=https://socials.yourclub.org

# --- Discord ------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# --- Google (Calendar + Gmail) -------------------------------------------------
# OAuth 2.0 client of type "Web application" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Instagram ------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Cloudinary (hosts local images so Instagram can fetch them) ---------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
