# Copy this file to .env and fill in the values you need.
# Only the services you actually use need credentials; the UI tells you
# what is missing for each action.

# There are two kinds of values here:
#   * APP credentials (client ids/secrets, the bot token): identify *this
#     installation* to Google/Meta/Discord. Set once by whoever hosts the app.
#   * ACCOUNT logins (which club Gmail, which Instagram): done in the web UI
#     under "Connections", never typed here.

# --- Web app -----------------------------------------------------------------
# Shared password for the web UI. Officers can also sign in with Google once
# they are added under Connections -> Officers. Leave both unset only for a
# private, local setup (the UI shows a warning).
APP_PASSWORD=change-me

# Optional: keep login sessions valid across restarts (any long random string).
# SOS_SECRET_KEY=

# Optional: where persistent data lives (default: ./data, /data in Docker).
# SOS_DATA_DIR=./data

# Public address of the app. Used to build the OAuth redirect URLs and, when
# it is https://, to serve event images to Instagram without Cloudinary.
# SOS_PUBLIC_URL=https://socials.yourclub.org

# --- Discord ------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# --- Google (Calendar + Gmail) -------------------------------------------------
# OAuth 2.0 client of type "Web application" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# --- Instagram ------------------------------------------------------------------
# Meta app with the "Instagram" product (API with Instagram Login). The club
# account is then connected with a button in the UI.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match a redirect URI registered on that Meta app.
# INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Legacy alternative: a manually generated Facebook Graph API token.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# --- Cloudinary (optional) --------------------------------------------------------
# Hosts local images so Instagram can fetch them. Not needed when
# SOS_PUBLIC_URL is an https:// address: the app serves the image itself.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
